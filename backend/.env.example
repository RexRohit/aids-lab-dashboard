# =======================================================================
# AI&DS Laboratory Audit Dashboard - Backend Environment Configuration
# =======================================================================

# Server Port (Render sets this dynamically, default is 10000 or 5000)
PORT=5000
NODE_ENV=production

# Admin Authentication
# Username for admin login (default: admin)
ADMIN_USERNAME=admin
# Generate bcrypt hash locally using: npm run set-admin-password
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
# Generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (Allowed for CORS)
FRONTEND_URL=https://aids-lab-dashboard.vercel.app

# Google Sheets Persistent Storage (Google Sheets API v4)
# 1. Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=1Wspnmg2nURjlA9R0Bh76jAepyW9hjaDNpwj9y1f_iD0

# Authentication Option A (Render Secret File):
# In Render Dashboard -> Environment -> Secret Files -> add "google-service-account.json"
# Path: /etc/secrets/google-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-service-account.json

# Authentication Option B (Render Environment Variable):
# Paste the entire content of the service account JSON file into GOOGLE_SERVICE_ACCOUNT_KEY:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# Authentication Option C (Separate email & private key):
# GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
